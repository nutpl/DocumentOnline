flowchart TB
    START(["เริ่ม"]) --> LOGIN[/"กรอกข้อมูลเข้าสู่ระบบ"/]
    LOGIN --> AUTH{"เข้าสู่ระบบสำเร็จ?"}
    AUTH -->|ไม่สำเร็จ| ERROR["แจ้งข้อผิดพลาด"]
    ERROR --> LOGIN
    AUTH -->|สำเร็จ| ROLE{"ประเภทผู้ใช้?"}
    ROLE -->|นักศึกษา| SM
    ROLE -->|อาจารย์| TM
    ROLE -->|เจ้าหน้าที่สาขา| FM
    ROLE -->|ผู้ดูแลระบบ| AM

    subgraph STUDENT["นักศึกษา"]
        SM{"เลือกเมนู"}
        SM -->|งานทะเบียน| RF[/"เลือก R.01 / R.12 / R.14 / R.18 / R.24<br/>กรอกข้อมูลและส่งคำร้อง"/]
        RF --> RA["อาจารย์ที่ปรึกษาพิจารณา"]
        RA --> RD{"ผลการพิจารณา?"}
        RD -->|ส่งกลับแก้ไข| RR[/"รับข้อเสนอแนะ แก้ไข และส่งใหม่"/]
        RR --> RA
        RD -->|อนุมัติ| RN["แจ้งผลนักศึกษาและผู้เกี่ยวข้อง"]
        RN --> PDF["ดาวน์โหลด / พิมพ์ PDF"]
        PDF --> SM

        SM -->|งานสหกิจ| IF[/"กรอกข้อมูลและส่งคำร้องสหกิจ"/]
        IF --> IA["อาจารย์ที่ปรึกษาพิจารณา"]
        IA --> ID{"ผลการพิจารณา?"}
        ID -->|ส่งกลับแก้ไข| IR[/"แก้ไขตามข้อเสนอแนะและส่งใหม่"/]
        IR --> IA
        ID -->|อนุมัติ| IC["อาจารย์ประสานงานพิจารณา"]
        IC --> ICD{"ผลการพิจารณา?"}
        ICD -->|ส่งกลับแก้ไข| ICR[/"แก้ไขตามข้อเสนอแนะและส่งใหม่"/]
        ICR --> IC
        ICD -->|อนุมัติ| IN["แจ้งผลอนุมัติ"]
        IN --> IP["ดาวน์โหลดและพิมพ์ PDF"]
        IP --> SIGN["ลงนามนอกระบบให้ครบ<br/>อาจารย์ที่ปรึกษาและอาจารย์ประสานงาน"]
        SIGN --> UP[/"อัปโหลดคำร้องฉบับลงนามครบ"/]
        UP --> CHECK["เจ้าหน้าที่ตรวจเอกสาร<br/>จัดทำหนังสือขอความอนุเคราะห์"]
        CHECK --> RESP[/"แจ้งผลจากสถานประกอบการ<br/>อัปโหลดหนังสือตอบรับเมื่อมีเอกสาร"/]
        RESP --> HAS{"มีหนังสือตอบรับ?"}
        HAS -->|ไม่มี / ยังไม่ทราบผล| FOLLOW["เจ้าหน้าที่ติดตามผลกับนักศึกษา"]
        FOLLOW --> RESP
        HAS -->|มี| REVIEW["เจ้าหน้าที่หรืออาจารย์ประสานงาน<br/>ตรวจหนังสือตอบรับ"]
        REVIEW --> RESULT{"ผลการตรวจสอบ?"}
        RESULT -->|ส่งกลับแก้ไข| RESP
        RESULT -->|ไม่รับเข้าฝึกงาน| NEW["เริ่มคำร้องสหกิจใหม่"]
        NEW --> IF
        RESULT -->|รับและเอกสารผ่าน| MOVE{"ย้ายสถานที่ฝึกงาน?"}
        MOVE -->|ใช่| NEW
        MOVE -->|ไม่ใช่| SEND["เจ้าหน้าที่จัดทำใบขอส่งตัว"]
        SEND --> TRACK["ติดตามสถานะสมัครงานและผลรับเข้าทำงาน<br/>จัดการแผนนิเทศครั้งที่ 1 และ 2"]
        TRACK --> SM
        SM -->|สถานะและประวัติ| SH["ตรวจสถานะคำร้อง / ประวัติ / แจ้งเตือน"]
        SH --> SM
        SM -->|ข้อมูลส่วนตัว| SP["จัดการข้อมูลส่วนตัว"]
        SP --> SM
    end

    subgraph TEACHER["อาจารย์"]
        TM{"เลือกเมนูตามหน้าที่และสิทธิ์"}
        TM -->|อาจารย์ที่ปรึกษา| TA["พิจารณาคำร้องทะเบียนและสหกิจ<br/>อนุมัติหรือส่งกลับพร้อมข้อเสนอแนะ"]
        TM -->|อาจารย์ประสานงาน| TC["พิจารณาคำร้องสหกิจต่อจากที่ปรึกษา<br/>อนุมัติหรือส่งกลับพร้อมข้อเสนอแนะ"]
        TM -->|หนังสือตอบรับ| TR["ผู้ประสานงานตรวจหนังสือตอบรับ<br/>บันทึกผลและติดตามสถานะสมัครงาน"]
        TM -->|แผนนิเทศ| TS["ตรวจและบันทึกแผนนิเทศครั้งที่ 1 และ 2"]
        TM -->|สถานะเอกสาร| TV["ตรวจสถานะเอกสารและแจ้งเตือน"]
        TA --> TM
        TC --> TM
        TR --> TM
        TS --> TM
        TV --> TM
    end

    subgraph STAFF["เจ้าหน้าที่สาขา"]
        FM{"เลือกเมนู"}
        FM -->|เอกสารสหกิจ| FD["ตรวจเอกสารสหกิจและหนังสือตอบรับ"]
        FM -->|หนังสือราชการ| FO["จัดทำหนังสือขอความอนุเคราะห์<br/>และใบขอส่งตัวตามเงื่อนไข"]
        FM -->|ข้อมูลสาขา| FT["จัดการอาจารย์ กลุ่มเรียน และที่ปรึกษา"]
        FM -->|แผนนิเทศและปฏิทิน| FS["จัดการแผนนิเทศครั้งที่ 1 และ 2<br/>และปฏิทินการศึกษา"]
        FM -->|ติดตามผล| FK["บันทึกสถานะสมัครงานและผลรับเข้าทำงาน"]
        FM -->|ค้นหาและส่งออก| FE["ค้นหาเอกสาร / ส่งออกข้อมูล Excel"]
        FD --> FM
        FO --> FM
        FT --> FM
        FS --> FM
        FK --> FM
        FE --> FM
    end

    subgraph ADMIN["ผู้ดูแลระบบ"]
        AM{"เลือกเมนู"}
        AM -->|ข้อมูลพื้นฐาน| AB["จัดการข้อมูลพื้นฐานและประเภทเอกสาร"]
        AM -->|บัญชีและสิทธิ์| AU["จัดการบัญชี ประเภทผู้ใช้ และสิทธิ์"]
        AM -->|ผู้เกี่ยวข้อง| AP["กำหนดอาจารย์ ผู้เกี่ยวข้อง และผู้ดำรงตำแหน่ง"]
        AM -->|ประวัติ| AH["ตรวจประวัติการใช้งาน<br/>สถานะและประวัติการพิจารณาเอกสาร"]
        AB --> AM
        AU --> AM
        AP --> AM
        AH --> AM
    end

    SM -->|ออกจากระบบ| LOGOUT["ออกจากระบบ"]
    TM -->|ออกจากระบบ| LOGOUT
    FM -->|ออกจากระบบ| LOGOUT
    AM -->|ออกจากระบบ| LOGOUT
    LOGOUT --> FINISH(["จบ"])

    classDef terminal fill:#dcfce7,stroke:#166534,color:#111827;
    classDef decision fill:#fef3c7,stroke:#a16207,color:#111827;
    classDef input fill:#ede9fe,stroke:#7c3aed,color:#111827;
    class START,FINISH terminal;
    class AUTH,ROLE,SM,TM,FM,AM,RD,ID,ICD,HAS,RESULT,MOVE decision;
    class LOGIN,RF,RR,IF,IR,ICR,UP,RESP input;
